# Copy this file to .env.local for local development. Never commit an
# actual .env.local (it is git-ignored). See docs/DEPLOYMENT.md for how
# each variable is configured per environment (development / rehearsal /
# production) in Vercel and Supabase.

# ---- App environment ----
# One of: development | rehearsal | production
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe ----
# Use a sk_test_... / pk_test_... pair for development and rehearsal.
# Use the live sk_live_... / pk_live_... pair ONLY in production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen`) locally, or the Dashboard webhook
# endpoint's signing secret in rehearsal/production.
STRIPE_WEBHOOK_SECRET=

# ---- Resend (email) ----
RESEND_API_KEY=
# Sender, reply-to and admin notification addresses are configured here,
# not hardcoded, so rehearsal and production can use different addresses.
EMAIL_FROM_ADDRESS="ABCF Silent Auction <auction@[PLACEHOLDER-DOMAIN]>"
EMAIL_REPLY_TO_ADDRESS=support@[PLACEHOLDER-DOMAIN]
ADMIN_NOTIFICATION_EMAIL=admin@[PLACEHOLDER-DOMAIN]

# Rehearsal-only: every rehearsal email is redirected here instead of the
# real bidder address, and the subject is prefixed [REHEARSAL - TEST ONLY].
# Required whenever APP_ENV=rehearsal; leave unset in development/production.
REHEARSAL_EMAIL_OVERRIDE=

# ---- Cron ----
# Long random secret. Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# ---- Public site content placeholders ----
NEXT_PUBLIC_EVENT_NAME="ABCF Silent Auction [PLACEHOLDER: confirm event name]"
NEXT_PUBLIC_EVENT_DATE_LABEL="[PLACEHOLDER: confirm event date]"
NEXT_PUBLIC_LOGO_URL=/logo-placeholder.svg
NEXT_PUBLIC_SUPPORT_EMAIL=support@[PLACEHOLDER-DOMAIN]
NEXT_PUBLIC_SUPPORT_PHONE="[PLACEHOLDER: confirm support phone]"
